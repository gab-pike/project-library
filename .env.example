# Local dev (`npm run dev`): DATA_DIR=./data.
# Docker/production: DATA_DIR=/data — the Dockerfile bind-mounts your host data folder there,
# and this file becomes the container's env_file, so this value must match the container
# path, not a path on the host.
DATA_DIR=./data
PORT=3000

MAX_UPLOAD_MB=200
# adapter-node's own request-body cap, in bytes — must be >= MAX_UPLOAD_MB or uploads 413
# before the app's own upload code ever sees them. 200MB shown; raise both together.
BODY_SIZE_LIMIT=209715200

# Generate both with:
#   node -e "const c=require('crypto'),s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Only needed when running behind a reverse proxy (Caddy/nginx) that terminates TLS.
# Without ORIGIN, SvelteKit's CSRF check compares the request's Origin header against its
# own guess at the site's URL and gets it wrong behind a proxy — form submissions (including
# login) silently 403. Set it to the exact public URL, protocol included:
# ORIGIN=https://projects.example.com
